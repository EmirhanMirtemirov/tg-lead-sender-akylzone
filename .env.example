# Telegram token from @BotFather.
TELEGRAM_BOT_TOKEN=123456:replace_me

# Optional but recommended: channel id where the leads are posted.
# Example: -1001234567890
SOURCE_CHANNEL_ID=

# Bot id of the bot whose messages are allowed.
# Telegram may omit sender id for channel posts; see ALLOWED_SENDER_FALLBACK_TEXT.
ALLOWED_SENDER_BOT_ID=

# Fallback check when Telegram does not expose from.id for a channel post.
# For your example this can be: Fusion AI Agent
ALLOWED_SENDER_FALLBACK_TEXT=Fusion AI Agent

# If true, skip channel posts when Telegram does not provide sender bot id.
# Keep false when using ALLOWED_SENDER_FALLBACK_TEXT as the backup check.
REQUIRE_SENDER_ID=false

# Google Sheets settings.
# You can use SPREADSHEET_ID from the table URL, or SPREADSHEET_NAME.
# SPREADSHEET_ID is more reliable. SPREADSHEET_NAME works if the service account can find the file by name.
SPREADSHEET_ID=
SPREADSHEET_NAME=new_marketing
SHEET_NAME=insta
# Sheet columns: A=№ B=Дата и Время C=Канал D=Имя клиента E=Номер телефона F=Класс G=Контекст/Запрос
SHEET_RANGE=insta!A:G

# Use one of these authentication options:
# 1) Path to downloaded service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# 2) Or paste the full service account JSON into one line:
GOOGLE_SERVICE_ACCOUNT_JSON=

# If true, bot parses and logs rows but does not write to Google Sheets.
DRY_RUN=false
